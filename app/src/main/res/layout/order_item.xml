<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:elevation="2dp"
    android:padding="8dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="60dp"
    android:background="@drawable/order_item_background_outline"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderNumber"
        android:textSize="18sp"
        android:text="@string/tv_order_number"
        android:textColor="@color/black"
        android:fontFamily="@font/product_sans_regular"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderDate"
        android:textSize="14sp"
        android:textColor="@color/light_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="64dp"
        app:layout_constraintBottom_toBottomOf="@id/tvOrderNumber"
        android:text="13/05/2024"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderTracking"
        app:layout_constraintTop_toBottomOf="@id/tvOrderNumber"
        android:fontFamily="@font/product_sans_regular"
        android:textColor="@color/light_gray"
        android:text="Tracking number: IK2832843284"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderQuantity"
        app:layout_constraintTop_toBottomOf="@id/tvOrderTracking"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/product_sans_regular"
        android:textColor="@color/light_gray"
        android:text="Quantity : 2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderTotalPrice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvOrderQuantity"
        android:fontFamily="@font/product_sans_regular"
        android:textColor="@color/light_gray"
        android:text="Subtotal: $230"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrderStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOrderQuantity"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:textSize="16sp"
        android:fontFamily="@font/product_sans_regular"
        android:textColor="@color/light_gray"
        android:text="Pending"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnOrderDetails"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvOrderTotalPrice"
        android:text="Details"
        android:gravity="center"
        android:background="@drawable/details_button_background"
        android:layout_width="100dp"
        android:layout_height="35dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>