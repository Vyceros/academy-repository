<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/carouselFragment">

    <fragment
        android:id="@+id/carouselFragment"
        android:name="com.example.baseandroidproject.presentation.carousel.CarouselFragment"
        android:label="fragment_carousel"
        tools:layout="@layout/fragment_carousel" >
        <action
            android:id="@+id/action_carouselFragment_to_messageFragment"
            app:destination="@id/messageFragment" />
        <action
            android:id="@+id/action_carouselFragment_to_heartFragment"
            app:destination="@id/heartFragment" />
    </fragment>
    <fragment
        android:id="@+id/heartFragment"
        android:name="com.example.baseandroidproject.presentation.heart.HeartFragment"
        android:label="fragment_heart"
        tools:layout="@layout/fragment_heart" />
    <fragment
        android:id="@+id/messageFragment"
        android:name="com.example.baseandroidproject.presentation.message.MessageFragment"
        android:label="MessageFragment" />
</navigation>